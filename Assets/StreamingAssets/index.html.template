<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebSocket Control</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
        }

        .top-row, .bottom-row {
            display: flex;
            justify-content: space-around;
            width: 100%;
        }

        .top-row {
            height: 30%;
        }

        .bottom-row {
            height: 70%;
        }

        .btn {
            flex: 1;
            margin: 10px;
            padding: 15px 20px;
            font-size: 64px;
            color: white;
            background-color: #3F99C8;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-align: center;
        }

        .btn:hover {
            background-color: #358bb9;
        }

        .btn:active {
            background-color: #67aed3;
        }
    </style>
    <script>
        function generateClientId() {
            return 'client-' + Math.random().toString(36).substr(2, 9);
        }

        const clientId = generateClientId();
        const socket = new WebSocket('ws://__SERVER_IP__:8080/GameControl');

        socket.onopen = function() {
            console.log('WebSocket is connected. Client ID:', clientId);
        };

        socket.onmessage = function(event) {
            console.log('Received from server: ' + event.data);
        };

        socket.onclose = function(event) {
            if (event.wasClean) {
                console.log('Connection closed cleanly');
            } else {
                console.log('Connection died');
            }
        };

        socket.onerror = function(error) {
            console.error('WebSocket Error: ' + error);
        };

        function sendCommand(command) {
            if (socket.readyState === WebSocket.OPEN) {
                const message = JSON.stringify({ clientId: clientId, command: command });
                socket.send(message);
            } else {
                console.error('WebSocket is not open.');
            }
        }
    </script>
</head>
<body>
<div class="top-row">
    <button class="btn" onclick="sendCommand('special_left')">⭘</button>
    <button class="btn" onclick="sendCommand('special_mid')">✪</button>
    <button class="btn" onclick="sendCommand('special_right')">⭘</button>
</div>

<div class="bottom-row">
    <button class="btn" onclick="sendCommand('move_left')">←</button>
    <button class="btn" onclick="sendCommand('move_right')">→</button>
</div>
</body>
</html>
